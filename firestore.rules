rules_version = '2';

// There is no Firebase Authentication in this deployment. Login is handled
// entirely by the client against passwords stored on the users/<forceNo>
// document (see js/db.js). These rules therefore cannot use request.auth;
// they instead constrain what fields a write may contain and how large a
// document may be, so trivial abuse doesn't blow past Spark-plan quotas or
// pollute the database with unknown collections.
//
// This is an intentional trade-off, documented in the app's plan file.
service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{forceNo} {
      allow read: if true;
      // Any write is allowed as long as the resulting document fits in ~4KB.
      // We deliberately don't enforce a strict field allow-list here: real
      // docs carry legacy fields (Rank, etc.) and imports may introduce new
      // ones over time — a schema check breaks Change Password / admin
      // reset writes on any doc that still has an old field. Size cap is
      // the practical stop-gap against abuse.
      allow write: if request.resource == null || request.resource.size() < 4096;
    }

    match /vehicles/{regNo} {
      allow read: if true;
      allow write: if request.resource == null || request.resource.size() < 4096;
    }

    match /movements/{id} {
      allow read: if true;
      allow write: if request.resource == null || request.resource.size() < 8192;
    }

    match /auditLog/{id} {
      allow read: if true;
      allow write: if request.resource == null || request.resource.size() < 4096;
    }

    // Forbid every other collection so an attacker cannot squat and dump
    // arbitrary data into the project.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
